const TEAM_OUTLOOK_2026={
  ARI:{wins:4.0,cls:'–'},ATL:{wins:7.5,cls:'P'},BAL:{wins:11.0,cls:'C'},BUF:{wins:10.5,cls:'C'},CAR:{wins:7.0,cls:'P'},
