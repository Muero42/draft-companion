  TEN:{wins:6.5,cls:'–'},WAS:{wins:7.5,cls:'P'}
};
function teamOutlookFor(team){return TEAM_OUTLOOK_2026[String(team||'').toUpperCase()]||{wins:null,cls:'–'}}
function de1(v){return Number.isFinite(Number(v))?Number(v).toFixed(1).replace('.',','):'–'}
function researchSignal(x){
  const rr=x?.researchResidual;if(!rr?.active||!Array.isArray(rr.components))return{arrows:'',reason:''};
  const components=rr.components.filter(c=>Number(c.dir)!==0),peak=dir=>components.filter(c=>Math.sign(Number(c.dir))===dir).sort((a,b)=>Number(b.strength||0)*Number(b.confidence||0)-Number(a.strength||0)*Number(a.confidence||0))[0];
  const pos=peak(1),neg=peak(-1),score=c=>c?Number(c.strength||0)*Number(c.confidence||0):0,ps=score(pos),ns=score(neg);
  if(!pos&&!neg)return{arrows:'',reason:''};
  const c=ps>=ns?pos:neg,s=Math.max(ps,ns),up=Number(c.dir)>0;
  return{arrows:s>=.58?(up?'↑↑':'↓↓'):s>=.30?(up?'↑':'↓'):'',reason:String(c.kind||'research').replaceAll('_',' ')};
}
function opportunityRole(p,players){
  const pos=String(p?.pos||'').toUpperCase();if(!['QB','RB','WR','TE'].includes(pos))return pos||'?';
  const explicit=Number(p?.depthOrder);if(Number.isFinite(explicit)&&explicit>=1&&explicit<=6)return `${pos}${Math.round(explicit)}`;
  const same=[];
  for(const [id,q] of Object.entries(players||{})){
    if(String(q?.team||'').toUpperCase()!==String(p?.team||'').toUpperCase()||String(q?.position||'').toUpperCase()!==pos)continue;
    const name=q?.full_name||[q?.first_name,q?.last_name].filter(Boolean).join(' ');if(!name)continue;
    const r=rankFor(name,pos),sr=Number(q?.search_rank);if(r&&Number.isFinite(r.rank))same.push({name,rank:r.rank,sr});
  }
  same.sort((a,b)=>a.rank-b.rank||(a.sr||9999)-(b.sr||9999));
  const idx=same.findIndex(q=>norm(q.name)===norm(p?.name));return `${pos}${idx>=0?idx+1:1}`;
}
function decisionContext(x,players){const t=teamOutlookFor(x?.p?.team),sig=researchSignal(x),role=opportunityRole(x?.p,players);return{...t,...sig,role,label:`${role} - ${x?.p?.team||'FA'} ${de1(t.wins)} ${t.cls}`}}
function pickConfidenceFor(x,rows){
  const best=Math.max(1,Number(rows?.[0]?.score)||Number(x?.score)||1),rel=clamp((Number(x?.score)||0)/best,0,1),data=.55*Number(x?.confidence||65)+.45*Number(x?.returnConfidence||65);
  return clamp(Math.round(data*(.60+.40*rel)),35,96);
}
